# ---------------------------------------------------------------------------
# Copy this file to .env and fill every value. Never commit .env.
# ---------------------------------------------------------------------------

# Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public URL of the Django server (used for media links in emails/websocket)
PUBLIC_BASE_URL=http://localhost:8000
# Public URL of the React dashboard (used for alert links in emails)
FRONTEND_URL=http://localhost:5173

# PostgreSQL (required - the project refuses to run on SQLite) ------------
DB_NAME=fingerprint_db
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Bootstrap owner account (used by `python manage.py create_owner`) ---------
OWNER_USERNAME=Engineer
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-password

# JWT ----------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Device authentication ----------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_API_KEY=replace-with-a-long-random-device-key
DEVICE_OFFLINE_AFTER_SECONDS=120

# Fingerprint template encryption (Fernet) ---------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TEMPLATE_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
MAX_TEMPLATE_BYTES=65536
MAX_PHOTO_BYTES=5242880

# Email --------------------------------------------------------------------
# Development: django.core.mail.backends.console.EmailBackend
# Production : django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Fingerprint Access <owner@example.com>
OWNER_EMAIL=owner@example.com
EMAIL_TIMEOUT=15

# CORS ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Redis channel layer (recommended in production) -----------------
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# Local time used by stats and email timestamps ----------------------------
TIME_ZONE=Africa/Kigali
