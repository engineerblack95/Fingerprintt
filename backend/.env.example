# ---------------------------------------------------------------------------
# Copy this file to .env and fill every value. Never commit .env.
# ---------------------------------------------------------------------------

# Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public URL of the Django server (used for media links in emails/websocket)
PUBLIC_BASE_URL=http://localhost:8000
# Public URL of the React dashboard (used for alert links in emails)
FRONTEND_URL=http://localhost:5173

# PostgreSQL (required - the project refuses to run on SQLite) ------------
DB_NAME=fingerprint_db
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Bootstrap owner account (used by `python manage.py create_owner`) ---------
OWNER_USERNAME=Engineer
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-password

# JWT ----------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Device authentication ----------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_API_KEY=replace-with-a-long-random-device-key
DEVICE_OFFLINE_AFTER_SECONDS=120

# Fingerprint template encryption (Fernet) ---------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TEMPLATE_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
MAX_TEMPLATE_BYTES=65536
MAX_PHOTO_BYTES=5242880

# Email --------------------------------------------------------------------
# Production transport: Brevo HTTP API (recommended). Set the api-key and use
# notifications.brevo_api.BrevoAPIEmailBackend as EMAIL_BACKEND. The "from"
# address must be a sender verified in the Brevo dashboard.
#   https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
EMAIL_BACKEND=notifications.brevo_api.BrevoAPIEmailBackend
# Alternative (no BREVO_API_KEY set): Brevo SMTP relay.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-brevo-login@example.com
# EMAIL_HOST_PASSWORD=replace-with-your-brevo-smtp-key
DEFAULT_FROM_EMAIL=Fingerprint Access <your-verified-sender@example.com>
OWNER_EMAIL=owner@example.com
EMAIL_TIMEOUT=15

# Cloudinary media storage (member photos) ----------------------------------
# Required on Render (ephemeral disk); optional locally - when empty, photos
# are stored under backend/media/ as before.
# Copy the exact value from the Cloudinary dashboard (Product environment -> API Keys)
CLOUDINARY_URL=cloudinary://replace-with-api-key:replace-with-api-secret@replace-with-cloud-name

# CORS ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Redis channel layer (recommended in production) -----------------
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# Local time used by stats and email timestamps ----------------------------
TIME_ZONE=Africa/Kigali
